# --- Web server ---

# Host and port for the local web interface
WEB_HOST=127.0.0.1
WEB_PORT=3000

# Optional fallback location for weather lookups when activity coordinates are missing
WEATHER_DEFAULT_LAT=
WEATHER_DEFAULT_LON=

# --- Training data source ---

# Intervals.icu is the only live training source.
TRAINING_SOURCE=intervals

# Personal API key. Used as the Basic Auth password with username API_KEY.
INTERVALS_API_KEY=

# Use 0 for the athlete associated with the API key.
INTERVALS_ATHLETE_ID=0

# Default date window for Intervals.icu refreshes when no CLI range is supplied.
INTERVALS_FETCH_DAYS=180

# --- Garmin Personal API wellness overlay (optional; disabled by default) ---

# Set true only after the external key/token files have owner-only permissions.
GARMIN_WELLNESS_ENABLED=false

# Keep both credential files outside this repository. Do not put key values in .env.
GARMIN_PERSONAL_API_KEY_FILE=/srv/repos/.garmin-personal-api-poc/credentials/api-key
GARMIN_PERSONAL_BEARER_TOKEN_CACHE_FILE=/srv/repos/.garmin-personal-api-poc/credentials/pacer-bearer-token.json

# Official Personal API base URL and per-request timeout.
GARMIN_PERSONAL_API_BASE_URL=https://personal.connectapi.garmin.com
GARMIN_WELLNESS_TIMEOUT_MS=8000
GARMIN_WELLNESS_TOTAL_TIMEOUT_MS=15000
GARMIN_WELLNESS_TIME_ZONE=America/Argentina/Buenos_Aires
# Non-secret operational reminder; Garmin keys do not have refresh tokens.
GARMIN_PERSONAL_API_KEY_EXPIRES_ON=2027-10-24

# --- Playwright capture (optional / secondary) ---

# Comma-separated list of URLs to capture as screenshots
TARGET_PAGES=

# Playwright browser session state.
# If empty, defaults to <STORAGE_DIR>/auth/browser-state.json.
AUTH_STATE_FILE=

# Set to false to run Chromium in headed mode (useful for debugging)
HEADLESS=true

# Root directory for all runtime storage
STORAGE_DIR=storage

# SQLite database file for session storage
DATABASE_FILE=

# Local export directory for CMS snapshots consumed later by run.nico.ar
CMS_EXPORT_DIR=

# --- run.nico.ar publish hook ---

# Required in a release deployment when run.nico.ar is not a sibling checkout.
# The Race calendar derives its file as <RUN_REPO>/data/manual/races.json.
RUN_REPO=

# Optional explicit override for the Race calendar JSON file. Prefer RUN_REPO.
RUN_SITE_RACES_FILE=

# Local script triggered by "Save and publish"
RUN_SITE_DEPLOY_SCRIPT=

# Deploy target for the static public site
# Defaults to pizero:/srv/data/www/run.nico.ar/
RUN_SITE_DEPLOY_TARGET=

# Public URL used for final production verification
RUN_SITE_PUBLIC_URL=https://run.nico.ar

# Timeout for build + deploy + verification
RUN_SITE_DEPLOY_TIMEOUT_MS=300000
