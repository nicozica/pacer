{
  "name": "pacer",
  "version": "0.1.0",
  "description": "Personal running workflow assistant",
  "scripts": {
    "web": "npm run dev:web",
    "dev:web": "ts-node --transpile-only src/web/server.ts",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.runtime.json",
    "build:all": "tsc -p tsconfig.json",
    "start": "node dist/web/server.js",
    "start:prod": "node dist/web/server.js",
    "sessions:publish": "ts-node --transpile-only src/session/publish-cli.ts",
    "sessions:rebuild-splits": "ts-node --transpile-only src/session/rebuild-km-splits-cli.ts",
    "sessions:seed": "ts-node --transpile-only src/session/seed-cli.ts",
    "sessions:seed:prod": "node dist/session/seed-cli.js",
    "test:session-enrichment": "ts-node --transpile-only src/session/enrichment-regression-cli.ts",
    "test:editor-identity": "ts-node --transpile-only src/session/editor-identity-regression-cli.ts",
    "test:race-matching": "ts-node --transpile-only src/races/service-regression-cli.ts",
    "training:fetch": "ts-node --transpile-only src/training/fetch-cli.ts",
    "training:fetch:prod": "node dist/training/fetch-cli.js",
    "intervals:smoke": "ts-node --transpile-only src/training/intervals-smoke-cli.ts",
    "test:garmin-wellness": "ts-node --transpile-only src/training/garmin-wellness-regression-cli.ts",
    "test:brief-segments": "ts-node --transpile-only src/training/brief-segments-regression-cli.ts",
    "test:coachat-unified": "ts-node --transpile-only src/coachat/unified-regression-cli.ts",
    "auth:garmin": "ts-node --transpile-only src/auth/login.ts garmin",
    "capture": "ts-node --transpile-only src/capture/runner.ts",
    "test:publish-attempts": "ts-node --transpile-only src/session/publish-attempt-regression-cli.ts",
    "test:next-run-publication": "ts-node --transpile-only src/session/next-run-distance-regression-cli.ts",
    "test:planned-session-type": "ts-node --transpile-only src/session/planned-session-type-regression-cli.ts",
    "test:review-publish-ui": "ts-node --transpile-only src/web/review-publish-ui-regression-cli.ts",
    "test:skip-workout": "ts-node --transpile-only src/workouts/skip-regression-cli.ts",
    "test:skip-completion": "ts-node --transpile-only src/workouts/skip-completion-regression-cli.ts",
    "test:remote-cancellation": "ts-node --transpile-only src/workouts/remote-cancellation-regression-cli.ts",
    "test:skip-workout-ui": "ts-node --transpile-only src/web/skip-workout-ui-regression-cli.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "dotenv": "^16.4.5",
    "fit-file-parser": "6.2.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.11.0",
    "playwright": "^1.42.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
