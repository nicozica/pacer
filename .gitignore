node_modules/
dist/

# Secrets
.env

# Runtime storage — keep folder structure, ignore contents
storage/screenshots/*
storage/db/*
storage/json/*
storage/auth/*
storage/logs/*
storage/locks/*
!storage/**/.gitkeep

# Root-level legacy/runtime SQLite files and their WAL/SHM sidecars.
storage/*.db
storage/*.db-*
storage/*.sqlite
storage/*.sqlite-*

# Verified local SQLite recovery points are production data, never Git content.
storage/recovery/*
!storage/recovery/.gitkeep

# Deployment artifacts and local rollback data
.deploy/
